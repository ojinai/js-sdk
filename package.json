{
  "name": "ojin-client",
  "version": "0.1.0",
  "description": "Ojin Speech-To-Video WebSocket client SDK for TypeScript",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./protocol": {
      "types": "./dist/esm/protocol/index.d.ts",
      "import": "./dist/esm/protocol/index.js",
      "require": "./dist/cjs/protocol/index.js",
      "default": "./dist/esm/protocol/index.js"
    },
    "./profiling": {
      "types": "./dist/esm/utils/profiling.d.ts",
      "import": "./dist/esm/utils/profiling.js",
      "require": "./dist/cjs/utils/profiling.js",
      "default": "./dist/esm/utils/profiling.js"
    },
    "./internal/uuid": {
      "types": "./dist/esm/utils/uuid.d.ts",
      "import": "./dist/esm/utils/uuid.js",
      "require": "./dist/cjs/utils/uuid.js",
      "default": "./dist/esm/utils/uuid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc --options typedoc.json --projectDocuments docs/concepts.md --projectDocuments docs/recipes/audio-from-node-stream.md --projectDocuments docs/recipes/forward-frames-to-client.md --projectDocuments docs/recipes/handle-interruption.md --projectDocuments docs/recipes/error-handling.md",
    "docs:check-examples": "node docs/check-examples.mjs",
    "bench": "vitest bench",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:wire-compat": "vitest run tests/fixtures/wire.test.ts",
    "lint": "biome check --fix src/ tests/",
    "lint:check": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "format:check": "biome format src/ tests/",
    "precommit": "pnpm lint:check && pnpm typecheck && pnpm test",
    "prepush": "pnpm precommit && pnpm security",
    "security": "pnpm security:secrets && pnpm security:sast && pnpm security:audit",
    "security:secrets": "betterleaks git --redact --no-banner",
    "security:sast": "semgrep scan --config=auto --error --quiet",
    "security:audit": "pnpm audit --audit-level=moderate",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ojin",
    "speech-to-video",
    "websocket",
    "avatar",
    "stv"
  ],
  "author": "Journee",
  "license": "Apache-2.0",
  "homepage": "https://github.com/journee-live/ojin",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "fast-check": "4.7.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@types/ws": "^8.5.0"
  },
  "peerDependenciesMeta": {
    "@types/ws": {
      "optional": true
    }
  }
}
